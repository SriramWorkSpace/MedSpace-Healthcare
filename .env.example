# MedSpace configuration. Copy to `.env`. Defaults run fully offline (no API keys needed).
# docker-compose.yml overrides the infrastructure URLs for containers.

# --- App ---------------------------------------------------------------------
ENV=dev
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173

# --- Data --------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://medspace:medspace@localhost:5432/medspace
REDIS_URL=redis://localhost:6379/0
# inline = jobs run inside the API process; arq = Redis queue + worker process
QUEUE_MODE=inline

# --- Auth --------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me-please-0123456789
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=false

# --- Rate limiting (ADR-027) ---
RATE_LIMIT_ENABLED=true
# auto: redis when QUEUE_MODE=arq, else in-process memory (single process only)
RATE_LIMIT_BACKEND=auto
# Proxies you run that append X-Forwarded-For (bundled nginx = 1). 0 ignores the header.
TRUSTED_PROXY_HOPS=0
# Multiplies every limit. Keep 1 in production.
RATE_LIMIT_SCALE=1
# Fernet key for OAuth tokens at rest. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Storage -----------------------------------------------------------------
# local = filesystem under STORAGE_LOCAL_DIR; s3 = any S3-compatible store (SeaweedFS, R2, S3)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.data/storage
S3_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY=medspace
S3_SECRET_KEY=medspace-secret
S3_BUCKET=medspace-documents
MAX_UPLOAD_MB=15
MAX_PAGES=30

# --- AI ----------------------------------------------------------------------
# fake = deterministic offline extractor/chat; groq = real models (needs GROQ_API_KEY)
LLM_PROVIDER=fake
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_CHAT_MODEL=openai/gpt-oss-120b
# hash = deterministic test embeddings; fastembed = local BAAI/bge-small-en-v1.5 (Docker default)
EMBEDDING_PROVIDER=hash

# --- Google Calendar & Tasks -------------------------------------------------
# fake = in-memory simulation; google = real OAuth (see README)
GOOGLE_PROVIDER=fake
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Demo --------------------------------------------------------------------
DEMO_ENABLED=true
DEMO_TTL_HOURS=24

# --- Dose reminders by push (ADR-028) ---
# Generate once: (cd backend && python -m app.shared.push). Without keys, delivery is simulated.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:privacy@medspace.example
PUSH_PROVIDER=auto

# --- Email (ADR-030) ---
# Without SMTP_HOST, emails go to an in-memory outbox (GET /api/dev/outbox?to=... outside prod).
MAIL_PROVIDER=auto
MAIL_FROM=MedSpace <no-reply@medspace.example>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls (587), ssl (465) or none (local relays only)
SMTP_SECURITY=starttls
DEV_OUTBOX_ENABLED=true
